package components

templ Base(title string) {
  <!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{title}</title>
      <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.js" integrity="sha384-Q+Dky3iHVJOr6wUjQ4ulh6uQ76an/t+ak1+PjMVaxRjbZamFLAG+u9InkfjbsEQf" crossorigin="anonymous"></script>
      <link rel="stylesheet" href="/public/css/tailwind.css" />
    </head>
    <body class="bg-zinc-900 text-zinc-50">
      <nav class="w-full bg-zinc-600 text-zinc-200 mx-auto p-5">
        <a class="text-lg text-zinc-200 hover:text-zinc-400 cursor-pointer" href="/">Home</a>
      </nav>
      <main class="flex flex-col justify-center items-center h-full p-5 bg-zinc-400 text-zinc-800 mx-5 my-5 rounded-2xl shadow-lg">
        <h1 class="text-2xl font-bold">{title}</h1>
        { children... }
      </main>
    </body>
  </html>
}
